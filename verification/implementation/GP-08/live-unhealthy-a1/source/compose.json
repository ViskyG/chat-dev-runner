{
  "services": {
    "api": {
      "command": [
        "python",
        "/src/api.py"
      ],
      "healthcheck": {
        "interval": "1s",
        "retries": 2,
        "test": [
          "CMD",
          "python",
          "-c",
          "raise SystemExit(1)"
        ],
        "timeout": "1s"
      },
      "image": "docker.io/library/python@sha256:4c47124a8391cb7a9f571164147d154777cf012a4ece5f86097130d7a4478111"
    },
    "migrate": {
      "command": [
        "python",
        "/src/migrate.py"
      ],
      "image": "docker.io/library/python@sha256:4c47124a8391cb7a9f571164147d154777cf012a4ece5f86097130d7a4478111"
    },
    "test": {
      "command": [
        "python",
        "/src/client.py",
        "unhealthy"
      ],
      "image": "docker.io/library/python@sha256:4c47124a8391cb7a9f571164147d154777cf012a4ece5f86097130d7a4478111"
    }
  }
}
