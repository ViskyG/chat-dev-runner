{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "change_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "base_head": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "upsert"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "expected_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "content_utf8": {
                "type": "string",
                "maxLength": 262144
              }
            },
            "required": [
              "op",
              "path",
              "expected_sha256",
              "content_utf8"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "delete"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "op",
              "path",
              "expected_sha256"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "change_id",
    "project_id",
    "workspace_id",
    "base_head",
    "files"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdr:changeset:1",
  "title": "Explicit UTF-8 changes, never implicit folder mirroring"
}
