{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdr:handoff:1",
  "title": "Proposed data-only handoff; not baseline Runner protocol",
  "type": "object",
  "required": [
    "protocol",
    "handoff_id",
    "project_id",
    "target_id",
    "purpose",
    "title",
    "base_commit",
    "artifacts",
    "entrypoint"
  ],
  "properties": {
    "protocol": {
      "const": "cdr-handoff/1"
    },
    "handoff_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "purpose": {
      "enum": [
        "design",
        "roadmap",
        "implementation",
        "assets",
        "reference"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "base_commit": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "drive_file_id",
          "drive_version",
          "filename",
          "size_bytes",
          "sha256",
          "media_type",
          "unpack"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "drive_file_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,200}$"
          },
          "drive_version": {
            "type": "string",
            "pattern": "^[0-9]{1,30}$"
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
          },
          "unpack": {
            "enum": [
              "none",
              "zip"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "entrypoint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "artifact_id",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
