{
  "type": "object",
  "properties": {
    "protocol": {
      "const": "cdr-mailbox/2"
    },
    "runner_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "slot_token": {
      "type": "string",
      "format": "uuid"
    },
    "dispatch": {
      "enum": [
        "DRAFT",
        "READY",
        "ACCEPTED",
        "REJECTED",
        "NEEDS_RESUBMIT"
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "enum": [
            "RUN_TASK",
            "SHELL",
            "CANCEL",
            "STATUS",
            "REDELIVER",
            "DELIVER_HANDOFF"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "github_branch",
                "local_workspace"
              ]
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "workspace_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
            }
          },
          "required": [
            "kind",
            "branch"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "local_workspace"
                  }
                }
              },
              "then": {
                "required": [
                  "workspace_id"
                ]
              }
            }
          ]
        },
        "task": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
        },
        "execution": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "native",
                "container"
              ]
            },
            "expected_os": {
              "enum": [
                "linux",
                "windows",
                "macos"
              ]
            },
            "backend_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
            },
            "profile_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          },
          "required": [
            "mode",
            "expected_os",
            "timeout_seconds"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "container"
                  }
                }
              },
              "then": {
                "required": [
                  "backend_id"
                ]
              }
            }
          ]
        },
        "shell": {
          "type": "object",
          "properties": {
            "dialect": {
              "enum": [
                "bash",
                "sh",
                "pwsh",
                "cmd"
              ]
            },
            "script": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            }
          },
          "required": [
            "dialect",
            "script"
          ],
          "additionalProperties": false
        },
        "target_request_id": {
          "type": "string",
          "format": "uuid"
        },
        "handoff": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:cdr:handoff:1",
          "title": "Proposed data-only handoff; not baseline Runner protocol",
          "type": "object",
          "required": [
            "protocol",
            "handoff_id",
            "project_id",
            "target_id",
            "purpose",
            "title",
            "base_commit",
            "artifacts",
            "entrypoint"
          ],
          "properties": {
            "protocol": {
              "const": "cdr-handoff/1"
            },
            "handoff_id": {
              "type": "string",
              "format": "uuid"
            },
            "project_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
            },
            "target_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
            },
            "purpose": {
              "enum": [
                "design",
                "roadmap",
                "implementation",
                "assets",
                "reference"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "base_commit": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                }
              ]
            },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": [
                  "artifact_id",
                  "drive_file_id",
                  "drive_version",
                  "filename",
                  "size_bytes",
                  "sha256",
                  "media_type",
                  "unpack"
                ],
                "properties": {
                  "artifact_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
                  },
                  "drive_file_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,200}$"
                  },
                  "drive_version": {
                    "type": "string",
                    "pattern": "^[0-9]{1,30}$"
                  },
                  "filename": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "media_type": {
                    "type": "string",
                    "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
                  },
                  "unpack": {
                    "enum": [
                      "none",
                      "zip"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "entrypoint": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "artifact_id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
                    },
                    "path": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "artifact_id",
                    "path"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "RUN_TASK"
              }
            }
          },
          "then": {
            "required": [
              "source",
              "task",
              "execution"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "shell"
                  ]
                },
                {
                  "required": [
                    "target_request_id"
                  ]
                },
                {
                  "required": [
                    "handoff"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "SHELL"
              }
            }
          },
          "then": {
            "required": [
              "source",
              "shell",
              "execution"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "task"
                  ]
                },
                {
                  "required": [
                    "target_request_id"
                  ]
                },
                {
                  "required": [
                    "handoff"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "CANCEL",
                  "STATUS",
                  "REDELIVER"
                ]
              }
            }
          },
          "then": {
            "required": [
              "target_request_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "source"
                  ]
                },
                {
                  "required": [
                    "task"
                  ]
                },
                {
                  "required": [
                    "execution"
                  ]
                },
                {
                  "required": [
                    "shell"
                  ]
                },
                {
                  "required": [
                    "handoff"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "DELIVER_HANDOFF"
              }
            }
          },
          "then": {
            "required": [
              "handoff"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "source"
                  ]
                },
                {
                  "required": [
                    "task"
                  ]
                },
                {
                  "required": [
                    "execution"
                  ]
                },
                {
                  "required": [
                    "shell"
                  ]
                },
                {
                  "required": [
                    "target_request_id"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "receipt": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "accepted_slot_token": {
              "type": "string",
              "format": "uuid"
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "status": {
              "enum": [
                "ACCEPTED",
                "REJECTED",
                "NEEDS_RESUBMIT",
                "ACK_UNKNOWN"
              ]
            },
            "queue_sequence": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "code": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "request_id",
            "accepted_slot_token",
            "payload_sha256",
            "status",
            "queue_sequence",
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol",
    "runner_id",
    "project_id",
    "slot_token",
    "dispatch",
    "request",
    "receipt"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdr:mailbox:2",
  "title": "Reusable live-intake mailbox with additive handoff delivery"
}
