{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdr:application-log:1",
  "title": "Normalized application log event / a project-defined schema",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "observed_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "enum": [
        "TRACE",
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR",
        "FATAL",
        "UNKNOWN"
      ]
    },
    "service": {
      "type": "string",
      "maxLength": 120
    },
    "event": {
      "type": "string",
      "maxLength": 200
    },
    "message": {
      "type": "string",
      "maxLength": 65536
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "attributes": {
      "type": "object",
      "maxProperties": 64
    }
  },
  "required": [
    "timestamp",
    "level",
    "service",
    "event",
    "message"
  ],
  "additionalProperties": false
}
