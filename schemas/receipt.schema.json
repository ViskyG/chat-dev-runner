{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "RUNNING",
        "COMPLETED",
        "REJECTED",
        "BLOCKED",
        "FAULT",
        "INTERRUPTED",
        "CANCELLED"
      ]
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "request_digest",
    "status",
    "code",
    "message",
    "observed_at",
    "run_id"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdr:receipt:1"
}
