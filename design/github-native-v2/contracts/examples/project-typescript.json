{
  "protocol": "cdr-project/2",
  "project_id": "example-project",
  "tasks": {
    "test": {
      "language": "typescript",
      "profile_id": "typescript-basic",
      "steps": [
        {
          "id": "prepare-1",
          "phase": "prepare",
          "argv": [
            "{npm}",
            "ci"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        },
        {
          "id": "typecheck-2",
          "phase": "typecheck",
          "argv": [
            "{tsc}",
            "--noEmit"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        },
        {
          "id": "test-3",
          "phase": "test",
          "argv": [
            "{vitest}",
            "run",
            "--reporter=junit",
            "--outputFile",
            "{output:junit}"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        }
      ],
      "outputs": [
        {
          "id": "junit",
          "source_root": "out",
          "path": "tests/junit.xml",
          "kind": "test_result",
          "format": "junit",
          "required": true,
          "publish": "git_if_fits"
        }
      ],
      "quality_gate": {
        "test_required": true,
        "minimum_executed": 1,
        "required_outputs": [
          "junit"
        ]
      }
    }
  }
}
