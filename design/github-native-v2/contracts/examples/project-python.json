{
  "protocol": "cdr-project/2",
  "project_id": "example-project",
  "tasks": {
    "test": {
      "language": "python",
      "profile_id": "python-basic",
      "steps": [
        {
          "id": "test-1",
          "phase": "test",
          "argv": [
            "{venv_python}",
            "-m",
            "pytest",
            "--junitxml",
            "{output:junit}"
          ],
          "cwd": ".",
          "timeout_seconds": 900
        }
      ],
      "outputs": [
        {
          "id": "junit",
          "source_root": "out",
          "path": "tests/junit.xml",
          "kind": "test_result",
          "format": "junit",
          "required": true,
          "publish": "git_if_fits"
        }
      ],
      "quality_gate": {
        "test_required": true,
        "minimum_executed": 1,
        "required_outputs": [
          "junit"
        ]
      }
    }
  }
}
