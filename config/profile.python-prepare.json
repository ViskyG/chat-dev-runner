{
  "schema_version": "1.0",
  "profile_id": "python-prepare",
  "description": "Reference profile: hash-locked, network-free wheel installation into /build",
  "execution_backend": "rootless_container",
  "image": "docker.io/library/python@sha256:4c47124a8391cb7a9f571164147d154777cf012a4ece5f86097130d7a4478111",
  "argv": [
    "python",
    "-m",
    "pip",
    "install",
    "--no-index",
    "--no-deps",
    "--require-hashes",
    "--only-binary=:all:",
    "--find-links=/src/vendor/wheels",
    "--target=/build",
    "--no-compile",
    "--no-cache-dir",
    "--disable-pip-version-check",
    "--root-user-action=ignore",
    "-r",
    "/src/requirements.lock"
  ],
  "timeout_seconds": 300,
  "network": "none",
  "memory_mb": 512,
  "cpu_limit": 1,
  "pids_limit": 128,
  "capabilities": "drop_all",
  "no_new_privileges": true,
  "read_only_root": true,
  "secrets": [],
  "output_budget_mb": 16,
  "collect": [],
  "approval": "Owner-local approval follows a real rootless image and offline preparation check.",
  "platform": "linux/amd64",
  "installed": false,
  "approved": false
}
