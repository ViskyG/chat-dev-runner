{
  "schema_version": "1.0",
  "profile_id": "python-quick",
  "description": "Reference profile: offline prepared pytest from /build, pinned rootless Python 3.12 image",
  "execution_backend": "rootless_container",
  "image": "docker.io/library/python@sha256:4c47124a8391cb7a9f571164147d154777cf012a4ece5f86097130d7a4478111",
  "argv": [
    "python",
    "-c",
    "import sys;sys.path[:0]=['/build','/src'];import pytest;raise SystemExit(pytest.main(sys.argv[1:]))",
    "-q",
    "-p",
    "no:cacheprovider",
    "--junitxml=/out/junit.xml"
  ],
  "timeout_seconds": 600,
  "network": "none",
  "memory_mb": 512,
  "cpu_limit": 1,
  "pids_limit": 128,
  "capabilities": "drop_all",
  "no_new_privileges": true,
  "read_only_root": true,
  "secrets": [],
  "output_budget_mb": 64,
  "collect": [
    {
      "id": "junit",
      "kind": "test_result",
      "path": "junit.xml",
      "format": "junit-xml",
      "required": true
    },
    {
      "id": "app-log",
      "kind": "application_log",
      "path": "app.jsonl",
      "format": "application-log/v1",
      "required": false
    }
  ],
  "approval": "Owner-local approval follows a real rootless image and offline preparation check.",
  "platform": "linux/amd64",
  "installed": false,
  "approved": false
}
